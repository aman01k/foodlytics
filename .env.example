# Copy to .env and edit. Never commit .env.
PGHOST=localhost
PGPORT=5432
PGUSER=your_os_user
PGPASSWORD=
PGDATABASE=foodlytics
# Optional: only needed if you prefer the official Kaggle download
# KAGGLE_USERNAME=
# KAGGLE_KEY=
# Hosted Postgres (Supabase/Neon) usually needs SSL:
# PGSSLMODE=require
